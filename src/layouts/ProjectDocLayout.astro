---
// ProjectDocLayout.astro - Dedicated Architecture & Threat Model Documentation Sub-page Layout
import Layout from './Layout.astro';

interface Props {
  title: string;
  tagline: string;
  category: string;
  technologies: string[];
  github: string;
  demo?: string;
  status?: string;
  metrics?: Record<string, string>;
}

const {
  title,
  tagline,
  category,
  technologies = [],
  github,
  demo,
  status = 'ACTIVE DEPLOYMENT',
  metrics = {},
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title={`${title} // Architecture Docs`}
  description={tagline}
  classification="ENGINEERING SPEC // EYES ONLY"
>
  <div class="project-doc-page">
    <div class="container doc-container">
      <!-- Breadcrumb Navigation -->
      <nav class="doc-breadcrumbs font-mono">
        <a href={`${baseUrl}/projects`} class="back-link">
          <span class="text-neon-cyan">&lt;==</span> RETURN TO PROJECT REPOSITORY
        </a>
        <span class="breadcrumb-current text-muted">/ DOCS / {category.toUpperCase()}</span>
      </nav>

      <!-- Project Specification Header -->
      <header class="doc-header anti-gravity-card">
        <div class="header-top">
          <div class="category-pill font-mono">{category}</div>
          <div class="status-pill font-mono">
            <span class="status-dot"></span>
            STATUS: <span class="text-neon-green">{status}</span>
          </div>
        </div>

        <h1 class="doc-title font-mono">{title}</h1>
        <p class="doc-tagline">{tagline}</p>

        <!-- Tech Stack Chips -->
        <div class="tech-chip-row">
          {
            technologies.map((tech) => (
              <span class="hud-badge font-mono">{tech}</span>
            ))
          }
        </div>

        <!-- Telemetry Metrics if available -->
        {
          Object.keys(metrics).length > 0 && (
            <div class="metrics-grid font-mono">
              {Object.entries(metrics).map(([key, val]) => (
                <div class="metric-box">
                  <div class="metric-key text-muted">{key}</div>
                  <div class="metric-val text-neon-cyan">{val}</div>
                </div>
              ))}
            </div>
          )
        }

        <!-- Action Links (GitHub Repo & Live Demo) -->
        <div class="doc-actions">
          <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            class="cyber-btn"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
              <path d="M9 18c-4.51 2-5-2-7-2"></path>
            </svg>
            <span>GITHUB REPOSITORY</span>
          </a>

          {
            demo && (
              <a
                href={demo}
                target="_blank"
                rel="noopener noreferrer"
                class="cyber-btn variant-green"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="2" y1="12" x2="22" y2="12"></line>
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                </svg>
                <span>LIVE TELEMETRY / DEMO</span>
              </a>
            )
          }
        </div>
      </header>

      <!-- Markdown Documentation Body -->
      <article class="doc-body markdown-prose">
        <slot />
      </article>

      <!-- Bottom Nav Bar -->
      <div class="doc-footer-nav font-mono">
        <a href={`${baseUrl}/projects`} class="cyber-btn">
          <span>&lt;= ALL ARCHITECTURE BLUEPRINTS</span>
        </a>
        <a href={`${baseUrl}/blog`} class="cyber-btn variant-ghost">
          <span>READ RELATED INTEL LOGS =&gt;</span>
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .project-doc-page {
    padding: 3rem 0 5rem 0;
  }

  .doc-container {
    max-width: 900px;
  }

  .doc-breadcrumbs {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px dashed rgba(0, 240, 255, 0.2);
    font-size: 0.85rem;
  }

  .back-link {
    color: var(--color-neon-cyan);
    text-decoration: none;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: #ffffff;
    text-shadow: var(--glow-cyan-sm);
  }

  .doc-header {
    padding: 2.5rem;
    margin-bottom: 3rem;
    background: rgba(7, 13, 29, 0.85);
    border: 1px solid rgba(0, 240, 255, 0.35);
  }

  .header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .category-pill {
    font-size: 0.75rem;
    color: var(--color-neon-cyan);
    background: rgba(0, 240, 255, 0.1);
    border: 1px solid rgba(0, 240, 255, 0.3);
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }

  .status-pill {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-neon-green);
    box-shadow: 0 0 8px var(--color-neon-green);
  }

  .doc-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    color: #ffffff;
    line-height: 1.2;
    margin-bottom: 0.85rem;
    text-shadow: 0 0 20px rgba(0, 240, 255, 0.2);
  }

  .doc-tagline {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-bottom: 1.75rem;
  }

  .tech-chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.75rem;
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1rem;
    padding: 1.25rem;
    background: rgba(4, 7, 17, 0.6);
    border: 1px solid rgba(0, 240, 255, 0.15);
    border-radius: 4px;
    margin-bottom: 2rem;
  }

  .metric-box {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .metric-key {
    font-size: 0.68rem;
    letter-spacing: 0.05em;
  }

  .metric-val {
    font-size: 1.1rem;
    font-weight: 700;
  }

  .doc-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .doc-body {
    margin-bottom: 4rem;
  }

  .doc-footer-nav {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(148, 163, 184, 0.15);
  }
</style>
