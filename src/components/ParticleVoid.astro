---
// ParticleVoid.astro - Zero-gravity interactive canvas background
interface Props {
  particleCount?: number;
}
const { particleCount = 55 } = Astro.props;
---

<div class="particle-void-container" aria-hidden="true">
  <canvas id="anti-gravity-canvas"></canvas>
  <div class="void-overlay"></div>
</div>

<script define:vars={{ particleCount }}>
  // Anti-gravity interactive particle simulation
  const canvas = document.getElementById('anti-gravity-canvas');
  if (canvas && canvas instanceof HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    if (ctx) {
      let width = (canvas.width = window.innerWidth);
      let height = (canvas.height = window.innerHeight);

      // Particle state
      const particles = [];
      const mouse = { x: -1000, y: -1000, radius: 140 };

      // Resize listener
      window.addEventListener('resize', () => {
        width = canvas.width = window.innerWidth;
        height = canvas.height = window.innerHeight;
      });

      // Mouse interaction for anti-gravity repulsion / levitation
      window.addEventListener('mousemove', (e) => {
        mouse.x = e.clientX;
        mouse.y = e.clientY;
      });

      window.addEventListener('mouseleave', () => {
        mouse.x = -1000;
        mouse.y = -1000;
      });

      // Particle class with weightless physics
      class Particle {
        constructor() {
          this.x = Math.random() * width;
          this.y = Math.random() * height;
          // Subtly drifting velocities simulating zero gravity
          this.vx = (Math.random() - 0.5) * 0.45;
          this.vy = (Math.random() - 0.5) * 0.45;
          this.radius = Math.random() * 1.8 + 0.8;
          // Theme colors: cyan, phosphor green, purple
          const colors = [
            'rgba(0, 240, 255, ',
            'rgba(0, 255, 102, ',
            'rgba(157, 78, 221, ',
          ];
          this.baseColor = colors[Math.floor(Math.random() * colors.length)];
          this.alpha = Math.random() * 0.6 + 0.2;
          this.pulseSpeed = 0.02 + Math.random() * 0.02;
          this.pulseAngle = Math.random() * Math.PI * 2;
        }

        update() {
          // Zero-gravity continuous float
          this.x += this.vx;
          this.y += this.vy;

          // Gentle breathing pulsation
          this.pulseAngle += this.pulseSpeed;
          const currentAlpha = Math.max(0.1, this.alpha + Math.sin(this.pulseAngle) * 0.2);

          // Wrap around edges to simulate infinite space
          if (this.x < 0) this.x = width;
          if (this.x > width) this.x = 0;
          if (this.y < 0) this.y = height;
          if (this.y > height) this.y = 0;

          // Anti-gravity mouse repulsion
          const dx = mouse.x - this.x;
          const dy = mouse.y - this.y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < mouse.radius) {
            const force = (1 - dist / mouse.radius) * 2.5;
            this.x -= (dx / dist) * force;
            this.y -= (dy / dist) * force;
          }

          return currentAlpha;
        }

        draw(currentAlpha) {
          ctx.beginPath();
          ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
          ctx.fillStyle = this.baseColor + currentAlpha + ')';
          ctx.shadowBlur = 8;
          ctx.shadowColor = this.baseColor + '0.8)';
          ctx.fill();
          ctx.shadowBlur = 0;
        }
      }

      // Initialize particles based on screen width
      const count = Math.min(particleCount, Math.floor(width / 22));
      for (let i = 0; i < count; i++) {
        particles.push(new Particle());
      }

      // Render loop
      let animationFrameId;
      const render = () => {
        ctx.clearRect(0, 0, width, height);

        // Connect nearby particles with subtle cyber constellation lines
        for (let i = 0; i < particles.length; i++) {
          const p1 = particles[i];
          const alpha1 = p1.update();
          p1.draw(alpha1);

          for (let j = i + 1; j < particles.length; j++) {
            const p2 = particles[j];
            const dx = p1.x - p2.x;
            const dy = p1.y - p2.y;
            const dist = Math.sqrt(dx * dx + dy * dy);
            const maxDist = 110;

            if (dist < maxDist) {
              const lineAlpha = (1 - dist / maxDist) * 0.16;
              ctx.beginPath();
              ctx.moveTo(p1.x, p1.y);
              ctx.lineTo(p2.x, p2.y);
              ctx.strokeStyle = `rgba(0, 240, 255, ${lineAlpha})`;
              ctx.lineWidth = 0.7;
              ctx.stroke();
            }
          }
        }

        animationFrameId = requestAnimationFrame(render);
      };

      render();
    }
  }
</script>

<style>
  .particle-void-container {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  #anti-gravity-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .void-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 50% 30%,
      transparent 0%,
      rgba(4, 7, 17, 0.4) 60%,
      rgba(4, 7, 17, 0.9) 100%
    );
  }
</style>
