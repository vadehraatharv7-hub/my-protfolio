---
import { path } from '../lib/url';
interface Props { slug: string; title: string; tagline: string; category: string; technologies: string[]; }
const { slug, title, tagline, category, technologies } = Astro.props;
---

<a class="card project" href={path(`/projects/${slug}/`)}>
  <span class="chip chip-accent">{category}</span>
  <h3>{title}</h3>
  <p class="muted">{tagline}</p>
  <div class="chips">
    {technologies.slice(0, 5).map((t) => <span class="chip">{t}</span>)}
  </div>
  <span class="more">Read the write-up →</span>
</a>

<style>
  .project { display: flex; flex-direction: column; gap: 12px; text-decoration: none; color: var(--text); transition: border-color 0.15s, transform 0.15s; height: 100%; }
  .project:hover { border-color: var(--accent); transform: translateY(-2px); color: var(--text); }
  .chip-accent { align-self: flex-start; }
  h3 { margin: 0; }
  p { margin: 0; font-size: 0.97rem; flex: 1; }
  .more { color: var(--accent); font-weight: 600; font-size: 0.92rem; }
</style>
