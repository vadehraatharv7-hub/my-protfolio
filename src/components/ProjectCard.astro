---
// ProjectCard.astro - Project Card with Anti-Gravity Levitation on Hover
interface Props {
  slug: string;
  title: string;
  tagline: string;
  description: string;
  category: string;
  technologies: string[];
  github: string;
  demo?: string;
  status?: string;
  metrics?: Record<string, string>;
  featured?: boolean;
}

const {
  slug,
  title,
  tagline,
  description,
  category,
  technologies = [],
  github,
  demo,
  status = 'OPERATIONAL',
  metrics = {},
  featured = false,
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const docUrl = `${baseUrl}/projects/${slug}`;
---

<div class={`project-card anti-gravity-card ${featured ? 'is-featured' : ''}`}>
  <!-- Decorative HUD brackets -->
  <div class="card-bracket top-left"></div>
  <div class="card-bracket top-right"></div>
  <div class="card-bracket bottom-left"></div>
  <div class="card-bracket bottom-right"></div>

  <!-- Header / Meta Bar -->
  <div class="card-header font-mono">
    <span class="category-tag">{category}</span>
    <div class="status-indicator">
      <span class="pulse-dot"></span>
      <span class="status-label">{status}</span>
    </div>
  </div>

  <!-- Content -->
  <div class="card-body">
    <h3 class="card-title font-mono">
      <a href={docUrl} class="title-link">
        {title}
      </a>
    </h3>

    <div class="card-tagline font-mono text-neon-cyan">
      // {tagline}
    </div>

    <p class="card-desc">
      {description}
    </p>

    <!-- Metrics Telemetry (if available) -->
    {
      Object.keys(metrics).length > 0 && (
        <div class="card-metrics font-mono">
          {Object.entries(metrics).map(([key, val]) => (
            <div class="metric-item">
              <span class="metric-label text-muted">{key}:</span>
              <span class="metric-value text-neon-green">{val}</span>
            </div>
          ))}
        </div>
      )
    }

    <!-- Tech Stack Tags -->
    <div class="tech-tags">
      {technologies.map((tech) => (
        <span class="hud-badge font-mono">{tech}</span>
      ))}
    </div>
  </div>

  <!-- Dual Action Buttons -->
  <div class="card-actions">
    <!-- Internal Link to Documentation Sub-Page -->
    <a href={docUrl} class="cyber-btn doc-btn">
      <span>DOCS & ARCHITECTURE</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>

    <!-- External GitHub Repository Link -->
    <a
      href={github}
      target="_blank"
      rel="noopener noreferrer"
      class="cyber-btn variant-ghost git-btn"
      title="View Source on GitHub"
      aria-label={`View ${title} source on GitHub`}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
        <path d="M9 18c-4.51 2-5-2-7-2"></path>
      </svg>
      <span class="font-mono text-xs">SRC</span>
    </a>
  </div>
</div>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.75rem;
    position: relative;
    border: 1px solid rgba(0, 240, 255, 0.22);
    background: rgba(8, 14, 30, 0.8);
  }

  .project-card.is-featured {
    border-color: rgba(0, 240, 255, 0.4);
  }

  /* HUD Corner Brackets */
  .card-bracket {
    position: absolute;
    width: 8px;
    height: 8px;
    pointer-events: none;
    transition: all 0.3s ease;
  }
  .top-left {
    top: -1px;
    left: -1px;
    border-top: 2px solid var(--color-neon-cyan);
    border-left: 2px solid var(--color-neon-cyan);
  }
  .top-right {
    top: -1px;
    right: -1px;
    border-top: 2px solid var(--color-neon-cyan);
    border-right: 2px solid var(--color-neon-cyan);
  }
  .bottom-left {
    bottom: -1px;
    left: -1px;
    border-bottom: 2px solid var(--color-neon-cyan);
    border-left: 2px solid var(--color-neon-cyan);
  }
  .bottom-right {
    bottom: -1px;
    right: -1px;
    border-bottom: 2px solid var(--color-neon-cyan);
    border-right: 2px solid var(--color-neon-cyan);
  }

  .project-card:hover .card-bracket {
    width: 14px;
    height: 14px;
    box-shadow: var(--glow-cyan-sm);
  }

  /* Card Header */
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
    font-size: 0.72rem;
  }

  .category-tag {
    color: var(--color-neon-cyan);
    background: rgba(0, 240, 255, 0.08);
    padding: 0.2rem 0.5rem;
    border-radius: 3px;
    border: 1px solid rgba(0, 240, 255, 0.25);
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-neon-green);
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-neon-green);
    box-shadow: 0 0 6px var(--color-neon-green);
  }

  /* Body */
  .card-body {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .card-title {
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 0.4rem;
  }

  .title-link {
    color: #ffffff;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .title-link:hover {
    color: var(--color-neon-cyan);
  }

  .card-tagline {
    font-size: 0.8rem;
    margin-bottom: 1rem;
    line-height: 1.4;
  }

  .card-desc {
    font-size: 0.88rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .card-metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 0.6rem 0.8rem;
    background: rgba(4, 7, 17, 0.6);
    border: 1px solid rgba(0, 240, 255, 0.12);
    border-radius: 4px;
    font-size: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .metric-item {
    display: flex;
    gap: 0.3rem;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
    margin-bottom: 1.5rem;
  }

  /* Actions */
  .card-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(148, 163, 184, 0.12);
  }

  .doc-btn {
    flex: 1;
    font-size: 0.78rem;
    padding: 0.65rem 0.9rem;
  }

  .git-btn {
    padding: 0.65rem 0.75rem;
  }
</style>
