---
// CyberHudStatus.astro - Real-time Cyber HUD Telemetry Strip
---

<div class="hud-strip font-mono" aria-label="Student Telemetry & Availability Status">
  <div class="container hud-strip-inner">
    <div class="hud-cell">
      <span class="hud-key text-muted">ACADEMIC_STATUS:</span>
      <span class="hud-val text-neon-green">DTU M.Sc. Cyber Security</span>
    </div>
    <div class="hud-cell">
      <span class="hud-key text-muted">BASE:</span>
      <span class="hud-val text-neon-cyan">Greater Copenhagen</span>
    </div>
    <div class="hud-cell">
      <span class="hud-key text-muted">WORK_PERMIT:</span>
      <span class="hud-val text-neon-green">Student Visa (90 hrs/month)</span>
    </div>
    <div class="hud-cell desktop-only">
      <span class="hud-key text-muted">TARGET_ROLE:</span>
      <span class="hud-val text-neon-amber">Studentermedhjælper</span>
    </div>
    <div class="hud-cell">
      <span class="hud-key text-muted">CPH_TIME:</span>
      <span id="hud-clock" class="hud-val text-neon-cyan">--:--:-- CET</span>
    </div>
  </div>
</div>

<script>
  // Live Copenhagen (CET/CEST) HUD clock
  const clockEl = document.getElementById('hud-clock');
  if (clockEl) {
    const updateTime = () => {
      const now = new Date();
      const timeStr = now.toLocaleTimeString('en-GB', {
        timeZone: 'Europe/Copenhagen',
        hour12: false,
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit'
      });
      clockEl.textContent = `${timeStr} CPH`;
    };
    updateTime();
    setInterval(updateTime, 1000);
  }
</script>

<style>
  .hud-strip {
    background: rgba(5, 9, 20, 0.95);
    border-top: 1px solid rgba(0, 240, 255, 0.15);
    border-bottom: 1px solid rgba(0, 240, 255, 0.15);
    padding: 0.5rem 0;
    font-size: 0.72rem;
    overflow-x: auto;
  }

  .hud-strip-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    white-space: nowrap;
  }

  .hud-cell {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .hud-key {
    color: var(--color-text-muted);
  }

  .hud-val {
    font-weight: 600;
  }
</style>
