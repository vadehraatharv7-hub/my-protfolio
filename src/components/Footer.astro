---
import { PERSON } from '../config';
import { path } from '../lib/url';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <div>
      <strong>{PERSON.name}</strong> <span class="faint">(ARV)</span>
      <p class="muted small">Cybersecurity MSc student at DTU. DevOps &amp; cloud engineer based in {PERSON.location}.</p>
    </div>
    <ul>
      <li><a href={path('/projects/')}>Projects</a></li>
      <li><a href={path('/blog/')}>Writing</a></li>
      <li><a href={path('/resume/')}>Resume</a></li>
      <li><a href={PERSON.github} rel="me noopener" target="_blank">GitHub</a></li>
      <li><a href={PERSON.linkedin} rel="me noopener" target="_blank">LinkedIn</a></li>
      <li><a href={`mailto:${PERSON.email}`}>Email</a></li>
      <li><a href={path('/rss.xml')}>RSS</a></li>
    </ul>
  </div>
  <div class="container legal small faint">© {year} {PERSON.name}. Built with Astro.</div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--border); margin-top: 64px; padding: 40px 0 28px; background: var(--bg-sunken); }
  .inner { display: flex; justify-content: space-between; gap: 32px; flex-wrap: wrap; }
  .small { font-size: 0.9rem; }
  p { margin: 6px 0 0; max-width: 360px; }
  ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 6px 20px; align-content: flex-start; max-width: 420px; }
  a { color: var(--text-muted); text-decoration: none; font-size: 0.95rem; }
  a:hover { color: var(--accent); }
  .legal { margin-top: 28px; }
</style>
