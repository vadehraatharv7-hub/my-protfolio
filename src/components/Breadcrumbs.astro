---
interface Props { items: { name: string; href?: string }[]; }
const { items } = Astro.props;
---
<nav class="crumbs faint" aria-label="Breadcrumb">
  {items.map((it, i) => (
    <>
      {it.href ? <a href={it.href}>{it.name}</a> : <span aria-current="page">{it.name}</span>}
      {i < items.length - 1 && <span aria-hidden="true"> / </span>}
    </>
  ))}
</nav>
<style>
  .crumbs { font-size: 0.88rem; margin-bottom: 20px; }
  .crumbs a { color: var(--text-muted); text-decoration: none; } .crumbs a:hover { color: var(--accent); }
</style>
