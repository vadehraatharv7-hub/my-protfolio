---
import { path } from '../lib/url';
import { CATEGORIES, type CategoryKey } from '../config';
interface Props { slug: string; title: string; description: string; date: Date; category: CategoryKey; minutes: number; }
const { slug, title, description, date, category, minutes } = Astro.props;
const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<article class="post">
  <div class="meta faint mono">
    <span class="chip chip-accent">{CATEGORIES[category].label}</span>
    <time datetime={date.toISOString()}>{fmt.format(date)}</time>
    <span>· {minutes} min read</span>
  </div>
  <h3><a href={path(`/blog/${slug}/`)}>{title}</a></h3>
  <p class="muted">{description}</p>
</article>

<style>
  .post { padding: 24px 0; border-bottom: 1px solid var(--border); }
  .post:first-child { padding-top: 0; }
  .meta { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; font-size: 0.8rem; margin-bottom: 10px; }
  h3 { font-size: 1.3rem; margin: 0 0 6px; }
  h3 a { color: var(--text); text-decoration: none; }
  h3 a:hover { color: var(--accent); }
  p { margin: 0; }
</style>
