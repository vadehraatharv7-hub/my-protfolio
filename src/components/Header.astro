---
// Header.astro - Cyberpunk HUD Navigation Bar
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const pathname = new URL(Astro.request.url).pathname;

const navLinks = [
  { name: '01.OVERVIEW', href: `${baseUrl}/` },
  { name: '02.PROJECTS', href: `${baseUrl}/projects` },
  { name: '03.INTEL_LOGS', href: `${baseUrl}/blog` },
];
---

<header class="cyber-header">
  <div class="container header-inner">
    <!-- Brand / Hacker Call-Sign -->
    <a href={`${baseUrl}/`} class="brand-link" aria-label="Home">
      <div class="brand-icon">
        <span class="icon-bracket">[</span>
        <span class="icon-core">λ</span>
        <span class="icon-bracket">]</span>
      </div>
      <div class="brand-text">
        <span class="brand-name">ATHARV<span class="brand-accent">.VADEHRA</span></span>
        <span class="brand-title">SEC_ARCH & DEVOPS</span>
      </div>
    </a>

    <!-- Live Telemetry Status Badge -->
    <div class="status-indicator desktop-only">
      <span class="status-dot"></span>
      <span class="status-text font-mono">SYS_STATUS: <span class="text-neon-green">NOMINAL</span></span>
      <span class="status-separator">|</span>
      <span class="status-meta font-mono">NODE: <span class="text-neon-cyan">ZERO-G</span></span>
    </div>

    <!-- Desktop Navigation Links -->
    <nav class="desktop-nav">
      <ul class="nav-list">
        {
          navLinks.map((link) => {
            const isActive =
              link.href === `${baseUrl}/`
                ? pathname === `${baseUrl}/` || pathname === `${baseUrl}`
                : pathname.startsWith(link.href);
            return (
              <li>
                <a
                  href={link.href}
                  class={`nav-link font-mono ${isActive ? 'active' : ''}`}
                >
                  <span class="nav-prefix">//</span> {link.name}
                  {isActive && <span class="active-pip" />}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <!-- Header Actions -->
    <div class="header-actions">
      <!-- CRT Scanline Toggle -->
      <button
        id="scanline-toggle"
        class="action-btn"
        title="Toggle CRT Scanline HUD"
        aria-label="Toggle Scanlines"
      >
        <span class="font-mono text-xs">CRT</span>
      </button>

      <!-- GitHub Link -->
      <a
        href="https://github.com/atharvvadehra"
        target="_blank"
        rel="noopener noreferrer"
        class="cyber-btn github-btn"
        aria-label="GitHub Profile"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="git-icon"
        >
          <path
            d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
          ></path>
          <path d="M9 18c-4.51 2-5-2-7-2"></path>
        </svg>
        <span class="desktop-only font-mono text-xs">GITHUB</span>
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button id="mobile-menu-btn" class="mobile-toggle" aria-label="Open Navigation Menu">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-drawer" class="mobile-drawer">
    <div class="drawer-header">
      <span class="font-mono text-xs text-neon-cyan">[ NAV_TERMINAL_V1.0 ]</span>
      <button id="close-drawer-btn" class="close-btn font-mono" aria-label="Close Menu">✕</button>
    </div>
    <ul class="mobile-nav-list">
      {
        navLinks.map((link) => (
          <li>
            <a href={link.href} class="mobile-nav-link font-mono">
              <span class="text-neon-cyan">&gt;</span> {link.name}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href="https://github.com/atharvvadehra"
          target="_blank"
          rel="noopener noreferrer"
          class="mobile-nav-link font-mono text-neon-green"
        >
          <span class="text-neon-green">&gt;</span> 04.GITHUB_PROFILE
        </a>
      </li>
    </ul>
    <div class="drawer-footer font-mono text-xs text-muted">
      SEC_PROTOCOL: ZERO_TRUST<br />
      STATUS: ACTIVE_LISTENER
    </div>
  </div>
</header>

<script>
  // Mobile drawer interaction
  const menuBtn = document.getElementById('mobile-menu-btn');
  const closeBtn = document.getElementById('close-drawer-btn');
  const drawer = document.getElementById('mobile-drawer');

  if (menuBtn && drawer && closeBtn) {
    const toggleMenu = () => {
      drawer.classList.toggle('is-open');
      document.body.classList.toggle('menu-lock');
    };

    menuBtn.addEventListener('click', toggleMenu);
    closeBtn.addEventListener('click', toggleMenu);

    // Close when clicking a link inside drawer
    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        drawer.classList.remove('is-open');
        document.body.classList.remove('menu-lock');
      });
    });
  }

  // CRT Scanline Toggle
  const scanlineBtn = document.getElementById('scanline-toggle');
  if (scanlineBtn) {
    scanlineBtn.addEventListener('click', () => {
      const scanlines = document.querySelector('.scanlines');
      if (scanlines) {
        if (scanlines.style.display === 'none') {
          scanlines.style.display = 'block';
          scanlineBtn.classList.remove('disabled');
        } else {
          scanlines.style.display = 'none';
          scanlineBtn.classList.add('disabled');
        }
      }
    });
  }
</script>

<style>
  .cyber-header {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    height: var(--nav-height);
    background: rgba(4, 7, 17, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(0, 240, 255, 0.18);
    transition: border-color 0.3s ease;
  }

  .cyber-header:hover {
    border-bottom-color: rgba(0, 240, 255, 0.4);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  /* Brand */
  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--color-text-primary);
  }

  .brand-icon {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-neon-cyan);
    text-shadow: var(--glow-cyan-sm);
    display: flex;
    align-items: center;
    animation: anti-gravity-float 5s ease-in-out infinite;
  }

  .icon-core {
    color: var(--color-neon-green);
    margin: 0 1px;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #ffffff;
  }

  .brand-accent {
    color: var(--color-neon-cyan);
  }

  .brand-title {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    color: var(--color-neon-green);
  }

  /* Status Indicator */
  .status-indicator {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.3rem 0.8rem;
    background: rgba(8, 14, 30, 0.8);
    border: 1px solid rgba(0, 255, 102, 0.25);
    border-radius: 4px;
    font-size: 0.72rem;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-neon-green);
    box-shadow: 0 0 8px var(--color-neon-green);
    animation: pulse-neon 2s infinite ease-in-out;
  }

  .status-separator {
    color: var(--color-text-muted);
  }

  /* Desktop Nav */
  .desktop-nav {
    display: flex;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    list-style: none;
  }

  .nav-link {
    text-decoration: none;
    color: var(--color-text-secondary);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    padding: 0.4rem 0.6rem;
    border-radius: 4px;
    position: relative;
    transition: all 0.25s ease;
  }

  .nav-prefix {
    color: var(--color-neon-cyan);
    opacity: 0.6;
    margin-right: 0.25rem;
  }

  .nav-link:hover {
    color: var(--color-neon-cyan);
    text-shadow: 0 0 8px rgba(0, 240, 255, 0.5);
  }

  .nav-link.active {
    color: #ffffff;
    background: rgba(0, 240, 255, 0.08);
    border: 1px solid rgba(0, 240, 255, 0.3);
  }

  .active-pip {
    position: absolute;
    bottom: -2px;
    left: 50%;
    transform: translateX(-50%);
    width: 14px;
    height: 2px;
    background: var(--color-neon-cyan);
    box-shadow: 0 0 6px var(--color-neon-cyan);
  }

  /* Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .action-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--color-text-secondary);
    border-radius: 4px;
    padding: 0.35rem 0.6rem;
    cursor: pointer;
    font-size: 0.75rem;
    transition: all 0.2s ease;
  }

  .action-btn:hover {
    color: var(--color-neon-cyan);
    border-color: var(--color-neon-cyan);
  }

  .action-btn.disabled {
    opacity: 0.4;
    text-decoration: line-through;
  }

  .github-btn {
    padding: 0.45rem 0.85rem;
    font-size: 0.75rem;
  }

  .git-icon {
    width: 15px;
    height: 15px;
  }

  /* Mobile menu button */
  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: space-around;
    width: 32px;
    height: 32px;
    background: transparent;
    border: 1px solid rgba(0, 240, 255, 0.3);
    border-radius: 4px;
    padding: 6px;
    cursor: pointer;
  }

  .mobile-toggle .bar {
    width: 100%;
    height: 2px;
    background: var(--color-neon-cyan);
    border-radius: 1px;
    transition: 0.3s;
  }

  /* Mobile Drawer */
  .mobile-drawer {
    display: none;
    position: fixed;
    top: 0;
    right: -100%;
    width: min(320px, 85vw);
    height: 100vh;
    background: #060b18;
    border-left: 1px solid var(--color-neon-cyan);
    box-shadow: -10px 0 30px rgba(0, 0, 0, 0.8);
    padding: 2rem 1.5rem;
    flex-direction: column;
    z-index: 1000;
    transition: right 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-drawer.is-open {
    right: 0;
  }

  .drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(0, 240, 255, 0.2);
    margin-bottom: 2rem;
  }

  .close-btn {
    background: transparent;
    border: 1px solid rgba(255, 0, 85, 0.4);
    color: var(--color-neon-crimson);
    border-radius: 4px;
    width: 30px;
    height: 30px;
    cursor: pointer;
    font-size: 1rem;
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .mobile-nav-link {
    display: block;
    font-size: 1rem;
    color: var(--color-text-primary);
    text-decoration: none;
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    transition: color 0.2s;
  }

  .mobile-nav-link:hover {
    color: var(--color-neon-cyan);
    padding-left: 0.5rem;
  }

  .drawer-footer {
    margin-top: auto;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    line-height: 1.6;
  }

  @media (max-width: 868px) {
    .desktop-only {
      display: none !important;
    }
    .desktop-nav {
      display: none;
    }
    .mobile-toggle {
      display: flex;
    }
    .mobile-drawer {
      display: flex;
    }
  }
</style>
