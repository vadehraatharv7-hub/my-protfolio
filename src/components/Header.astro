---
import { path } from '../lib/url';
const current = Astro.url.pathname;
const links = [
  { href: path('/projects/'), label: 'Projects' },
  { href: path('/blog/'), label: 'Writing' },
  { href: path('/resume/'), label: 'Resume' },
  { href: path('/#contact'), label: 'Contact' },
];
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={path('/')} aria-label="Atharv Vadehra — home">
      <span class="brand-mark" aria-hidden="true">AV</span>
      <span class="brand-name">Atharv Vadehra</span>
    </a>
    <nav aria-label="Primary">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} aria-current={current.startsWith(l.href.replace(/#.*/, '')) && !l.href.includes('#') ? 'page' : undefined}>{l.label}</a></li>
        ))}
        <li>
          <button id="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
            <svg class="i-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="i-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--border); }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 64px; gap: 16px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; color: var(--text); font-weight: 700; letter-spacing: -0.01em; }
  .brand:hover { color: var(--text); }
  .brand-mark { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 8px; background: var(--accent); color: var(--accent-contrast); font-size: 0.8rem; font-weight: 800; }
  nav ul { display: flex; align-items: center; gap: 4px; list-style: none; margin: 0; padding: 0; }
  nav a { display: block; padding: 8px 12px; border-radius: 8px; color: var(--text-muted); text-decoration: none; font-size: 0.95rem; font-weight: 500; }
  nav a:hover, nav a[aria-current='page'] { color: var(--text); background: var(--bg-sunken); }
  #theme-toggle { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 8px; border: 0; background: transparent; color: var(--text-muted); cursor: pointer; }
  #theme-toggle:hover { background: var(--bg-sunken); color: var(--text); }
  :global(:root[data-theme='dark']) .i-moon { display: none; }
  :global(:root:not([data-theme='dark'])) .i-sun { display: none; }
  @media (max-width: 560px) {
    .brand-name { display: none; }
    nav a { padding: 8px 8px; font-size: 0.9rem; }
  }
</style>
