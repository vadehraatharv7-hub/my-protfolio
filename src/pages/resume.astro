---
import Layout from '../layouts/Layout.astro';
import { PERSON } from '../config';
import { path, abs } from '../lib/url';
import { experience, skills, education } from '../data/profile';
import { breadcrumbLd } from '../lib/schema';
---

<Layout
  title="Resume"
  description="Resume of Atharv Vadehra (ARV): cybersecurity MSc student at DTU with DevOps, cloud and security engineering experience."
  jsonLd={[breadcrumbLd([{ name: 'Home', path: '/' }, { name: 'Resume' }])]}
>
  <div class="container wrap">
    <div class="toolbar no-print">
      <a href={path('/')}>← Back to portfolio</a>
      <div class="actions">
        <a class="btn btn-primary" href={path('/resume.pdf')} download="Atharv_Vadehra_Resume.pdf">Download PDF</a>
        <button class="btn" id="print">Print</button>
      </div>
    </div>

    <article class="sheet card">
      <header>
        <h1>{PERSON.name}</h1>
        <p class="muted">
          {PERSON.location} · <a href={`mailto:${PERSON.email}`}>{PERSON.email}</a> ·
          <a href={PERSON.github} rel="me">GitHub</a> · <a href={PERSON.linkedin} rel="me">LinkedIn</a>
        </p>
      </header>

      <section>
        <h2>Summary</h2>
        <p>
          Cybersecurity master’s student at DTU with strong hands-on experience in DevOps and cloud infrastructure. I bridge complex
          security architectures and smooth developer experiences, and I’m looking for a studentermedhjælper role (up to 90 hrs/month)
          supporting a team’s cloud security operations and automation.
        </p>
      </section>

      <section>
        <h2>Education</h2>
        {education.map((e) => (
          <div class="row"><div><h3>{e.school}</h3><p class="muted">{e.degree} · {e.place}</p></div><span class="chip">{e.dates}</span></div>
        ))}
      </section>

      <section>
        <h2>Experience</h2>
        {experience.map((e) => (
          <div class="job">
            <div class="row"><div><h3>{e.role}</h3><p class="muted">{e.org} · {e.kind}</p></div><span class="chip">{e.dates}</span></div>
            <ul>{e.points.map((p) => <li>{p}</li>)}</ul>
          </div>
        ))}
      </section>

      <section>
        <h2>Technical projects</h2>
        <ul>
          <li><a href={path('/projects/ai-soc-azure-honeypot/')}>AI-SOC / Azure honeypot</a> — Cowrie honeypot on Azure via Terraform, Loki and Grafana telemetry, LLM-based attack classification.</li>
          <li><a href={path('/projects/k8s-production-cluster/')}>Kubernetes production cluster (homelab)</a> — Proxmox, k3s, Traefik, Grafana and NAT.</li>
          <li><a href={path('/projects/rag-vector-search/')}>RAG + vector search system</a> — embedding pipeline with FAISS and ChromaDB powering production chatbot workflows.</li>
        </ul>
      </section>

      <section>
        <h2>Skills &amp; languages</h2>
        <ul>
          {skills.map(([k, v]) => <li><strong>{k}:</strong> {v}</li>)}
          <li><strong>Languages:</strong> English (fluent, C2) · Danish (beginner, enrolled in courses)</li>
        </ul>
      </section>
    </article>
  </div>
</Layout>

<script>
  document.getElementById('print')?.addEventListener('click', () => window.print());
</script>

<style>
  .wrap { padding-top: 32px; }
  .toolbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 12px; }
  .actions { display: flex; gap: 10px; }
  .sheet { max-width: 860px; margin: 0 auto; padding: 48px; }
  header { margin-bottom: 8px; } header h1 { font-size: 2.2rem; margin-bottom: 4px; }
  section { margin-top: 28px; } section h2 { font-size: 0.85rem; font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); border-bottom: 1px solid var(--border); padding-bottom: 6px; margin-bottom: 14px; }
  .row { display: flex; justify-content: space-between; gap: 12px; align-items: flex-start; flex-wrap: wrap; margin-bottom: 8px; }
  h3 { margin: 0; font-size: 1.05rem; } .row p { margin: 0; font-size: 0.95rem; }
  .job { margin-bottom: 18px; } ul { margin: 8px 0 0; padding-left: 1.2em; } li { margin-bottom: 5px; }
  @media (max-width: 640px) { .sheet { padding: 24px 18px; } }
  @media print { .sheet { border: 0; box-shadow: none; padding: 0; } }
</style>
