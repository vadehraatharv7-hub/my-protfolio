---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import { PERSON, DEFAULT_DESCRIPTION } from '../config';
import { path, abs } from '../lib/url';
import { getPosts, getProjects, readingMinutes } from '../lib/posts';
import { experience, skills, talks, faq } from '../data/profile';

const projects = await getProjects();
const posts = (await getPosts()).slice(0, 3);

const jsonLd = [
  {
    '@type': 'ProfilePage',
    '@id': abs('/') + '#profile',
    url: abs('/'),
    name: 'Atharv Vadehra (ARV) — portfolio',
    mainEntity: { '@id': abs('/') + '#person' },
    isPartOf: { '@id': abs('/') + '#website' },
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
];
---

<Layout
  rawTitle
  type="profile"
  title="Atharv Vadehra (ARV) — Cybersecurity & DevOps Engineer in Copenhagen"
  description={DEFAULT_DESCRIPTION}
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Cybersecurity · DevOps · Cloud</p>
        <h1>Atharv Vadehra</h1>
        <p class="alias muted">Also known as <strong>ARV</strong></p>
        <p class="lead">
          I’m a cybersecurity MSc student at the Technical University of Denmark (DTU) with hands-on experience in
          DevOps and cloud infrastructure. I build secure, automated systems and write about how they work.
        </p>
        <p class="status"><span class="dot" aria-hidden="true"></span> Open to a <strong>studentermedhjælper</strong> role in Copenhagen · up to 90 hrs/month</p>
        <div class="actions">
          <a class="btn btn-primary" href={path('/#contact')}>Get in touch</a>
          <a class="btn" href={path('/projects/')}>See projects</a>
          <a class="btn" href={path('/resume.pdf')} download="Atharv_Vadehra_Resume.pdf">Download CV</a>
        </div>
      </div>
      <img class="portrait" src={path(PERSON.headshot)} alt="Portrait of Atharv Vadehra" width="280" height="280" fetchpriority="high" />
    </div>
  </section>

  <section class="section" id="about">
    <div class="container two-col">
      <div>
        <p class="eyebrow">About</p>
        <h2>Security-minded engineer, built on infrastructure</h2>
      </div>
      <div class="about-copy">
        <p>
          I’m studying for an M.Sc. in Computer Science with a specialisation in cyber security at DTU (2026–), after a B.Tech in
          Digital Transformation at Atria University in Bangalore (2021–2025).
        </p>
        <p>
          Before moving to Denmark I worked on Kubernetes, AWS and GCP infrastructure at Elmet.ai and Corover AI: least-privilege
          IAM, zero-downtime certificate automation across 40+ services, and faster, safer CI/CD. At home I run a Proxmox + k3s
          lab and a cloud honeypot to learn how real attacks behave.
        </p>
        <p>
          I’m learning Danish (beginner) and I’m fluent in English. Outside of work I enjoy strategy games and cybersecurity fiction.
        </p>
      </div>
    </div>
  </section>

  <section class="section" id="projects">
    <div class="container">
      <div class="section-head">
        <div><p class="eyebrow">Projects</p><h2>Selected work</h2></div>
        <a href={path('/projects/')}>All projects →</a>
      </div>
      <div class="grid">
        {projects.slice(0, 4).map((p) => (
          <ProjectCard slug={p.id} title={p.data.title} tagline={p.data.tagline} category={p.data.category} technologies={p.data.technologies} />
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="writing">
    <div class="container">
      <div class="section-head">
        <div><p class="eyebrow">Writing</p><h2>Write-ups &amp; notes</h2></div>
        <a href={path('/blog/')}>All posts →</a>
      </div>
      {posts.length > 0 ? (
        <div class="narrow">{posts.map((p) => (
          <PostCard slug={p.id} title={p.data.title} description={p.data.description} date={p.data.date} category={p.data.category} minutes={readingMinutes(p.body)} />
        ))}</div>
      ) : (
        <p class="muted">Project write-ups and notes on cyber and AI news are on the way. Subscribe via <a href={path('/rss.xml')}>RSS</a>.</p>
      )}
    </div>
  </section>

  <section class="section" id="experience">
    <div class="container">
      <div class="section-head"><div><p class="eyebrow">Experience</p><h2>Where I’ve worked</h2></div></div>
      <ol class="timeline">
        {experience.map((e) => (
          <li class="card job">
            <div class="job-head">
              <div><h3>{e.role}</h3><p class="muted org">{e.org} · {e.kind}</p></div>
              <span class="chip">{e.dates}</span>
            </div>
            <ul>{e.points.map((pt) => <li>{pt}</li>)}</ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="skills">
    <div class="container">
      <div class="section-head"><div><p class="eyebrow">Skills</p><h2>Toolbox</h2></div></div>
      <dl class="skills">
        {skills.map(([k, v]) => (<div class="card"><dt>{k}</dt><dd class="muted">{v}</dd></div>))}
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="container two-col">
      <div><p class="eyebrow">Community</p><h2>Talks &amp; leadership</h2></div>
      <ul class="plain">
        {talks.map((t) => (<li><strong>{t.what}</strong><br /><span class="muted">{t.where} · {t.when}</span></li>))}
        <li><strong>Operations Manager, Beyonder’s Hackathon</strong><br /><span class="muted">Atria University’s first inter-college hackathon</span></li>
      </ul>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="container two-col">
      <div><p class="eyebrow">FAQ</p><h2>Quick answers</h2></div>
      <div>
        {faq.map(([q, a]) => (<details><summary>{q}</summary><p class="muted">{a}</p></details>))}
      </div>
    </div>
  </section>

  <section class="section" id="contact">
    <div class="container">
      <div class="card contact">
        <h2>Let’s talk</h2>
        <p class="muted">
          I’m looking for a part-time studentermedhjælper role in Greater Copenhagen (cloud, DevOps or security) and I’m happy to chat about projects or collaborations.
        </p>
        <div class="actions">
          <a class="btn btn-primary" href={`mailto:${PERSON.email}`}>{PERSON.email}</a>
          <a class="btn" href={PERSON.linkedin} target="_blank" rel="me noopener">LinkedIn</a>
          <a class="btn" href={PERSON.github} target="_blank" rel="me noopener">GitHub</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero { padding: 72px 0 56px; }
  .hero-grid { display: grid; grid-template-columns: 1fr auto; gap: 48px; align-items: center; }
  .alias { margin: -4px 0 20px; }
  .lead { font-size: 1.2rem; max-width: 620px; color: var(--text-muted); }
  .status { display: inline-flex; align-items: center; gap: 10px; padding: 8px 14px; background: var(--bg-sunken); border: 1px solid var(--border); border-radius: 999px; font-size: 0.92rem; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: #16a34a; box-shadow: 0 0 0 4px rgba(22, 163, 74, 0.2); flex: none; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  .portrait { width: 280px; height: 280px; object-fit: cover; border-radius: 24px; border: 1px solid var(--border); box-shadow: var(--shadow); }
  .two-col { display: grid; grid-template-columns: 1fr 2fr; gap: 48px; }
  .about-copy p { color: var(--text-muted); }
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .narrow { max-width: 760px; }
  .timeline { list-style: none; padding: 0; margin: 0; display: grid; gap: 16px; }
  .job-head { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; align-items: flex-start; }
  .job h3 { margin: 0; } .org { margin: 2px 0 0; }
  .job ul { margin: 12px 0 0; padding-left: 1.2em; color: var(--text-muted); } .job li { margin-bottom: 6px; }
  .skills { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin: 0; }
  dt { font-weight: 650; margin-bottom: 6px; } dd { margin: 0; font-size: 0.97rem; }
  .plain { list-style: none; padding: 0; margin: 0; display: grid; gap: 18px; }
  details { border-bottom: 1px solid var(--border); padding: 14px 0; }
  summary { cursor: pointer; font-weight: 600; } details p { margin: 10px 0 0; }
  .contact { text-align: center; padding: 48px 24px; }
  .contact p { max-width: 560px; margin: 0 auto; } .contact .actions { justify-content: center; }
  @media (max-width: 800px) {
    .hero-grid, .two-col { grid-template-columns: 1fr; gap: 28px; }
    .portrait { order: -1; width: 120px; height: 120px; border-radius: 20px; }
    .grid, .skills { grid-template-columns: 1fr; }
    .hero { padding-top: 40px; }
  }
</style>
