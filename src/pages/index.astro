---
// index.astro - Atharv Vadehra Portfolio (Aligned with Official Resume)
import Layout from '../layouts/Layout.astro';
import FloatingTechStack from '../components/FloatingTechStack.astro';
import CyberHudStatus from '../components/CyberHudStatus.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const resumePdfUrl = `${baseUrl}/resume.pdf`;

// Load projects and blog posts from Astro Content Collections
const preferredOrder = [
  'ai-soc-azure-honeypot',
  'k8s-production-cluster',
  'rag-vector-search',
  'cloud-security-architecture',
];

const allProjects = await getCollection('projects');
const sortedProjects = [...allProjects].sort((a, b) => {
  const indexA = preferredOrder.indexOf(a.id);
  const indexB = preferredOrder.indexOf(b.id);
  if (indexA !== -1 && indexB !== -1) return indexA - indexB;
  if (indexA !== -1) return -1;
  if (indexB !== -1) return 1;
  return 0;
});
const featuredProjects = sortedProjects.slice(0, 4);

const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);
---

