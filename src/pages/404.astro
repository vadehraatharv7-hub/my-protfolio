---
import Layout from '../layouts/Layout.astro';
import { path } from '../lib/url';
---
<Layout title="Page not found" noindex>
  <div class="container wrap">
    <p class="eyebrow">404</p>
    <h1>This page doesn’t exist</h1>
    <p class="muted">The link may be broken or the page may have moved.</p>
    <p><a class="btn btn-primary" href={path('/')}>Back to home</a> <a class="btn" href={path('/blog/')}>Read the blog</a></p>
  </div>
</Layout>
<style>.wrap { padding-top: 96px; padding-bottom: 96px; }</style>
