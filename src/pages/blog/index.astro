---
// blog/index.astro - Markdown-Driven Classified Blog Index
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// Statically query and sort all Markdown files in src/content/blog/
const rawPosts = await getCollection('blog');
const posts = rawPosts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

// Collect all unique tags
const allTags = ['ALL', ...new Set(posts.flatMap((p) => p.data.tags || []))];
---

<Layout
  title="Intel Logs // Classified Technical Dispatches"
  description="Statically generated security logs and architectural debriefs covering Kubernetes hardening, eBPF, network anomaly analysis, and virtualization."
  classification="ARCHIVED INTEL REPOSITORY // RESTRICTED ACCESS"
>
  <div class="blog-index-page">
    <div class="container">
      <!-- Classified Dossier Header -->
      <header class="blog-header">
        <div class="header-pre font-mono text-neon-green">[ ARCHIVES // 03.INTEL_LOGS ]</div>
        <h1 class="page-title font-mono">CLASSIFIED TECHNICAL DISPATCHES</h1>
        <p class="page-lead">
          Declassified operational briefs, research logs, and security architecture postmortems.
          Authored by <strong>Atharv Vadehra</strong>. Fully rendered from Markdown via static compilation pipeline.
        </p>

        <!-- Terminal Search & Filter -->
        <div class="blog-controls font-mono">
          <div class="search-box">
            <span class="search-prefix text-neon-cyan">query_logs:</span>
            <input
              type="text"
              id="blog-search-input"
              placeholder="Search by keyword, CVE, or tech..."
              autocomplete="off"
            />
          </div>

          <div class="tag-pills" id="tag-filter-bar">
            {
              allTags.map((tag, idx) => (
                <button
                  class={`tag-btn ${idx === 0 ? 'active' : ''}`}
                  data-tag={tag}
                >
                  #{tag}
                </button>
              ))
            }
          </div>
        </div>
      </header>

      <!-- Blog Posts Log Feed -->
      <div class="posts-feed" id="posts-feed">
        {
          posts.map((post) => (
            <article
              class="post-log-item anti-gravity-card"
              data-title={post.data.title.toLowerCase()}
              data-subtitle={post.data.subtitle.toLowerCase()}
              data-tags={(post.data.tags || []).join(',').toLowerCase()}
            >
              <div class="post-card-inner">
                <!-- Log Metadata Header -->
                <div class="log-meta font-mono">
                  <div class="meta-left">
                    <span class="log-id text-neon-cyan">LOG-{post.data.date.replace(/-/g, '')}</span>
                    <span class="meta-sep">|</span>
                    <span class="log-date text-neon-green">{post.data.date}</span>
                    <span class="meta-sep">|</span>
                    <span class="log-time text-neon-amber">{post.data.time}</span>
                  </div>
                  <div class="meta-right">
                    <span class="classification-badge font-mono text-neon-crimson">
                      {post.data.classification || 'RESTRICTED'}
                    </span>
                  </div>
                </div>

                <!-- Post Title & Subtitle -->
                <h2 class="post-title font-mono">
                  <a href={`${baseUrl}/blog/${post.id}`} class="post-title-link">
                    {post.data.title}
                  </a>
                </h2>

                <p class="post-subtitle">
                  {post.data.subtitle}
                </p>

                <!-- Tags and Sources Attestation -->
                <div class="post-bottom-row">
                  <div class="post-tags font-mono">
                    {(post.data.tags || []).map((t) => (
                      <span class="tag-chip">#{t}</span>
                    ))}
                  </div>

                  <div class="post-action font-mono">
                    {post.data.sources && post.data.sources.length > 0 && (
                      <span class="sources-pill text-muted">
                        [{post.data.sources.length} CITATIONS]
                      </span>
                    )}
                    <a href={`${baseUrl}/blog/${post.id}`} class="decrypt-btn">
                      <span>DECRYPT LOG &gt;&gt;</span>
                    </a>
                  </div>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <!-- No Results Message -->
      <div id="no-results" class="no-results-msg font-mono" style="display: none;">
        <span class="text-neon-crimson">[ ERR_NO_MATCH ]</span>: No intelligence logs match current search parameters.
      </div>
    </div>
  </div>
</Layout>

<script>
  // Client-side search and tag filtering for instantaneous responsiveness
  const searchInput = document.getElementById('blog-search-input') as HTMLInputElement | null;
  const tagButtons = document.querySelectorAll('#tag-filter-bar .tag-btn');
  const postItems = document.querySelectorAll('#posts-feed .post-log-item');
  const noResults = document.getElementById('no-results');

  let activeTag = 'ALL';
  let activeQuery = '';

  const applyFilters = () => {
    let visibleCount = 0;

    postItems.forEach((item) => {
      const el = item as HTMLElement;
      const title = el.getAttribute('data-title') || '';
      const subtitle = el.getAttribute('data-subtitle') || '';
      const tags = el.getAttribute('data-tags') || '';

      const matchesTag = activeTag === 'ALL' || tags.includes(activeTag.toLowerCase());
      const matchesQuery =
        activeQuery === '' ||
        title.includes(activeQuery) ||
        subtitle.includes(activeQuery) ||
        tags.includes(activeQuery);

      if (matchesTag && matchesQuery) {
        el.style.display = 'block';
        visibleCount++;
      } else {
        el.style.display = 'none';
      }
    });

    if (noResults) {
      noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  };

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      activeQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
      applyFilters();
    });
  }

  tagButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      tagButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      activeTag = btn.getAttribute('data-tag') || 'ALL';
      applyFilters();
    });
  });
</script>

<style>
  .blog-index-page {
    padding: 3.5rem 0 6rem 0;
  }

  .blog-header {
    margin-bottom: 3.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(0, 240, 255, 0.2);
  }

  .header-pre {
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    margin-bottom: 0.75rem;
  }

  .page-title {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 700;
    color: #ffffff;
    line-height: 1.2;
    margin-bottom: 1.25rem;
    text-shadow: 0 0 25px rgba(0, 255, 102, 0.2);
  }

  .page-lead {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    max-width: 820px;
    margin-bottom: 2rem;
  }

  /* Search & Filter Controls */
  .blog-controls {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .search-box {
    display: flex;
    align-items: center;
    background: rgba(8, 14, 30, 0.85);
    border: 1px solid rgba(0, 240, 255, 0.3);
    border-radius: 4px;
    padding: 0.5rem 1rem;
    max-width: 500px;
  }

  .search-prefix {
    font-size: 0.85rem;
    margin-right: 0.6rem;
  }

  .search-box input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.88rem;
  }

  .search-box input::placeholder {
    color: var(--color-text-muted);
  }

  .tag-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag-btn {
    background: rgba(12, 20, 43, 0.6);
    border: 1px solid rgba(0, 255, 102, 0.2);
    color: var(--color-text-secondary);
    padding: 0.35rem 0.75rem;
    border-radius: 4px;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    transition: all 0.2s ease;
  }

  .tag-btn:hover {
    color: var(--color-neon-green);
    border-color: var(--color-neon-green);
    background: rgba(0, 255, 102, 0.08);
  }

  .tag-btn.active {
    color: #040711;
    background: var(--color-neon-green);
    border-color: var(--color-neon-green);
    font-weight: 700;
    box-shadow: var(--glow-green-sm);
  }

  /* Posts Feed */
  .posts-feed {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .post-log-item {
    padding: 2rem;
    border: 1px solid rgba(0, 240, 255, 0.22);
    background: rgba(8, 14, 30, 0.85);
  }

  .log-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.75rem;
    margin-bottom: 1rem;
  }

  .meta-left {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .meta-sep {
    color: var(--color-text-muted);
  }

  .classification-badge {
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--color-neon-crimson);
    background: rgba(255, 0, 85, 0.06);
    border-radius: 2px;
  }

  .post-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .post-title-link {
    color: #ffffff;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .post-title-link:hover {
    color: var(--color-neon-cyan);
    text-shadow: 0 0 10px rgba(0, 240, 255, 0.4);
  }

  .post-subtitle {
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
  }

  .post-bottom-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px dashed rgba(0, 240, 255, 0.15);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag-chip {
    font-size: 0.72rem;
    color: var(--color-neon-cyan);
    background: rgba(0, 240, 255, 0.06);
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
  }

  .post-action {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.8rem;
  }

  .sources-pill {
    font-size: 0.72rem;
  }

  .decrypt-btn {
    color: var(--color-neon-green);
    text-decoration: none;
    font-weight: 700;
    letter-spacing: 0.05em;
    transition: all 0.2s;
  }

  .decrypt-btn:hover {
    color: #ffffff;
    text-shadow: var(--glow-green-sm);
    transform: translateX(4px);
  }

  .no-results-msg {
    padding: 3rem 1.5rem;
    text-align: center;
    background: rgba(8, 14, 30, 0.7);
    border: 1px dashed rgba(255, 0, 85, 0.3);
    border-radius: 4px;
  }
</style>
