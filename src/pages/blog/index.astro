---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getPosts, readingMinutes } from '../../lib/posts';
import { CATEGORIES } from '../../config';
import { path, abs } from '../../lib/url';
import { breadcrumbLd } from '../../lib/schema';

const posts = await getPosts();
const jsonLd = [
  breadcrumbLd([{ name: 'Home', path: '/' }, { name: 'Writing' }]),
  { '@type': 'Blog', name: 'Writing by Atharv Vadehra', url: abs('/blog/'), author: { '@id': abs('/') + '#person' } },
];
---

<Layout
  title="Writing — project write-ups, cyber and AI news"
  description="Project write-ups and commentary on cybersecurity and AI news by Atharv Vadehra (ARV)."
  jsonLd={jsonLd}
>
  <div class="container wrap">
    <Breadcrumbs items={[{ name: 'Home', href: path('/') }, { name: 'Writing' }]} />
    <p class="eyebrow">Writing</p>
    <h1>Write-ups &amp; notes</h1>
    <p class="lead muted">How I built things, and what I make of the news in cybersecurity and AI.</p>
    <nav class="filters" aria-label="Categories">
      <a class="chip chip-accent" href={path('/blog/')} aria-current="page">All</a>
      {Object.entries(CATEGORIES).map(([k, v]) => <a class="chip" href={path(`/blog/category/${k}/`)}>{v.plural}</a>)}
      <a class="chip" href={path('/rss.xml')}>RSS</a>
    </nav>
    <div class="list">
      {posts.length === 0 && <p class="muted">The first posts are on the way.</p>}
      {posts.map((p) => <PostCard slug={p.id} title={p.data.title} description={p.data.description} date={p.data.date} category={p.data.category} minutes={readingMinutes(p.body)} />)}
    </div>
  </div>
</Layout>

<style>
  .wrap { padding-top: 48px; padding-bottom: 32px; }
  .lead { font-size: 1.1rem; max-width: 640px; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin: 24px 0 36px; }
  .filters a { text-decoration: none; padding: 5px 12px; } .filters a:hover { border-color: var(--accent); }
  .list { max-width: 760px; }
</style>
