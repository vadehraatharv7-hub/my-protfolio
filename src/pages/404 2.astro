---
// 404.astro - Terminal Access Denied / Lost in the Void
import Layout from '../layouts/Layout.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="404 // ACCESS_DENIED // PACKET_LOST"
  description="Security boundary breach: The requested coordinate does not exist in this sector."
  classification="SECURITY ALERT // TRACE ACTIVE"
>
  <div class="error-page">
    <div class="container error-container">
      <div class="error-card anti-gravity-card variant-crimson levitate-medium">
        <div class="error-header font-mono">
          <span class="text-neon-crimson">[ ERR_SECTOR_NOT_FOUND ]</span>
          <span class="text-muted">TRACE_ID: 0xDEADBEEF</span>
        </div>

        <div class="glitch-number font-mono text-neon-crimson">404</div>

        <h1 class="error-title font-mono">PACKET ROUTED INTO ZERO-GRAVITY VOID</h1>
        
        <p class="error-msg">
          The node or memory segment you requested has either been wiped, quarantined by eBPF security policies,
          or drifted beyond the observable perimeter.
        </p>

        <div class="error-terminal font-mono">
          <div class="term-line"><span class="text-muted">&gt; iptables -L -n -v</span> ... [DENY ALL]</div>
          <div class="term-line"><span class="text-muted">&gt; traceroute destination</span> ... [* * * Request timed out]</div>
          <div class="term-line"><span class="text-neon-green">&gt; auto_remediation</span> ... [ENGAGED]</div>
        </div>

        <div class="error-actions font-mono">
          <a href={`${baseUrl}/`} class="cyber-btn">
            <span>&lt;= RETURN TO SECURE GATEWAY</span>
          </a>
          <a href={`${baseUrl}/projects`} class="cyber-btn variant-ghost">
            <span>VIEW SYSTEMS DIRECTORY</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .error-page {
    padding: 6rem 0;
    min-height: 70vh;
    display: flex;
    align-items: center;
  }

  .error-container {
    max-width: 650px;
  }

  .error-card {
    padding: 3rem 2.5rem;
    background: rgba(8, 14, 30, 0.9);
    border: 1px solid rgba(255, 0, 85, 0.4);
    text-align: center;
  }

  .error-header {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    margin-bottom: 2rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px dashed rgba(255, 0, 85, 0.3);
  }

  .glitch-number {
    font-size: clamp(5rem, 12vw, 7rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.05em;
    margin-bottom: 1rem;
    text-shadow: 0 0 30px rgba(255, 0, 85, 0.6);
  }

  .error-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 1rem;
  }

  .error-msg {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-bottom: 2rem;
  }

  .error-terminal {
    background: rgba(3, 6, 14, 0.8);
    border: 1px solid rgba(255, 0, 85, 0.2);
    border-radius: 4px;
    padding: 1rem;
    font-size: 0.78rem;
    text-align: left;
    margin-bottom: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .error-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
